# Neon-managed values: populate with neon env pull for your selected branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Application values: generate a different cookie secret for each environment.
NEON_AUTH_COOKIE_SECRET=
APP_ORIGIN=http://localhost:3000
DOCUMENTS_BUCKET=documents

# Local project agents (server-only; direct MiniMax API)
MINIMAX_API_KEY=
# Optional. Default: .data/projects beneath the app's working directory.
# PROJECTS_DIRECTORY=/absolute/path/to/projects
