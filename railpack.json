{
  "$schema": "https://schema.railpack.com",
  "packages": { "bun": "1.4.3" },
  "steps": {
    "build": { "commands": ["bun --bun run build"] }
  },
  "deploy": {
    "startCommand": "bun .output/server/index.mjs",
    "variables": { "NODE_ENV": "production", "HOST": "0.0.0.0", "PORT": "3000" }
  }
}
